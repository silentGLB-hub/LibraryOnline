{
  "info": {
    "name": "LibraryOnline - Complete Demo",
    "description": "Run in order with LibraryOnline Local environment and cookie jar enabled. Mutates demo: creates one loan, returns it, creates and removes one reading list. Repeatable using member20.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Anonymous session / CSRF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"csrfToken\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Member login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/session/login",
        "body": {
          "mode": "raw",
          "raw": "{\"Email\": \"{{memberEmail}}\", \"Password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Refresh authenticated CSRF",
      "request": {
        "method": "GET",
