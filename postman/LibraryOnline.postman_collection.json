              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"csrfToken\", pm.response.json().csrfToken);",
              "pm.test(\"Member role\",()=>pm.expect(pm.response.json().user.role).to.eql(\"Member\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Catalog and choose available book",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/books?availability=available&pageSize=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const books=pm.response.json().items; pm.test(\"Has books\",()=>pm.expect(books.length).above(0)); pm.environment.set(\"bookId\",books[books.length-1].Id);"
            ]
          }
        }
      ]
    },
