{
  "info": {
    "name": "LibraryOnline - Reader and Preview",
    "description": "Uses seeded active loan book 11 for member01 and overdue book 1. Run before these demo loans expire or change. Cookie jar enabled. Password comes from private local environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public author, work and publisher",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/11/information",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Information available\",()=>pm.expect(pm.response.json().authorBiography).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Public preview only",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/11/preview",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"No second chapter\",()=>pm.expect(pm.response.json().text).not.include(\"Chương 2\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/session",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.environment.set(\"csrfToken\",pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login active borrower",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/session/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"Email\": \"member01@library.local\", \"Password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Authenticated CSRF",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/session",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.environment.set(\"csrfToken\",pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read first chapter",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/11/reader?chapter=1",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Three demo chapters\",()=>pm.expect(pm.response.json().totalChapters).to.eql(3));",
              "pm.test(\"No cache\",()=>pm.expect(pm.response.headers.get(\"Cache-Control\")).include(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read second chapter",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/11/reader?chapter=2",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Chapter two\",()=>pm.expect(pm.response.json().chapter).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid chapter blocked",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/11/reader?chapter=99",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Overdue loan blocked",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/1/reader",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Member cannot read editor",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/11/material",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/session/logout",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous full text blocked",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/11/reader",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}